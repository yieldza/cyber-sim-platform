# Copy this file to .env and edit the values before running docker compose up.
# Never commit .env to version control.

# Public ports
API_PORT=8080
WEB_PORT=8088

# Internal worker auth (long random string)
WORKER_API_KEY=change-me-to-a-long-random-string

# JWT signing secret for API auth
JWT_SECRET=change-me-to-another-long-random-string

# Initial admin user (created on first start if no users exist)
ADMIN_USER=admin
ADMIN_PASS=change-me-strong-password

# Docker Hub image coordinates (used by docker-compose + scripts/build-and-push.sh)
IMAGE_REPO=124000pk/yieldpk
TAG_API=csp-api-0.5.0
TAG_WORKER=csp-worker-0.5.0
TAG_WEB=csp-web-0.5.0
